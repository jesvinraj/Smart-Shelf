# SmartShelf environment configuration.
# Copy to .env and adjust as needed. All values are optional (sane defaults in config.py).

# Secret key for Flask sessions. CHANGE THIS in production.
SECRET_KEY=dev-insecure-secret-key-change-me

# Database URL (SQLite is the default). Examples:
#   sqlite:///smart_shelf.db
#   postgresql+psycopg2://user:pass@localhost/smartshelf
#   mysql+pymysql://user:pass@localhost/smartshelf
DATABASE_URL=sqlite:///smart_shelf.db

# Business rules
EXPIRY_ALERT_DAYS=30
REORDER_SAFETY_FACTOR=1.5

# Security
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Production: set true when serving over HTTPS (docker-compose sets it).
SESSION_COOKIE_SECURE=false

# DB pool tuning (MySQL / PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
